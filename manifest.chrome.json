{
  "manifest_version": 3,
  "name": "FocusGuard – Productivity & YouTube Tools",
  "version": "4.0.0",
  "description": "Track time, block distractions, and measure the real cost of your browsing habits.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["productivity-content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "48": "icons/icon48.png"
    },
    "default_title": "FocusGuard – Productivity & YouTube Tools",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["mascot-styles.css"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
